# Copy to inputs.env, fill while working through INPUTS.md, then run
# scripts/apply-inputs.mjs from the new repo. No secrets in here — tokens go
# in the shared encrypted secrets file.

APP_NAME=Doctrine
APP_SLUG=doctrine-mobile
URL_SCHEME=doctrine
EXPO_OWNER=mp-lb

# Permanent identity — cannot be changed after first store submission.
# iOS allows hyphens; Android package does not.
IOS_BUNDLE_ID=com.mp-lb.doctrine
ANDROID_PACKAGE=com.mplb.doctrine

# From App Store Connect (numeric "Apple ID" on the app's App Information
# page) and the Apple Developer membership page.
APP_STORE_CONNECT_APP_ID=6779461527
APPLE_TEAM_ID=A1B2C3D4E5

# Production endpoints. The Clerk key is the *publishable* (pk_live_) key —
# it base64-encodes the frontend API domain, so it changes if the domain does.
API_BASE_URL=https://api.doctrine.example
CLERK_PUBLISHABLE_KEY=pk_live_xxxx

# Written by `eas init`; leave blank until then.
EAS_PROJECT_ID=
