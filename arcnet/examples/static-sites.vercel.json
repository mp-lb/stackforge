{
  "repository": "REPLACE_OWNER/hello-world",
  "account": {
    "type": "team",
    "id": "team_REPLACE"
  },
  "sites": {
    "web": {
      "mode": "existing",
      "projectId": "prj_REPLACE",
      "projectName": "hello-world-web",
      "build": [
        "pnpm",
        "--filter",
        "@hello-world/hello-world-web",
        "build"
      ],
      "output": "apps/web/dist",
      "outputConfig": {
        "version": 3,
        "routes": [
          {
            "handle": "filesystem"
          },
          {
            "src": "/(.*)",
            "dest": "/index.html"
          }
        ]
      }
    }
  }
}
