{
  "frontend": {
    "module": "vercel-static",
    "domain": "example-app-preview.mp-lb.dev",
    "build": "pnpm --filter @mp-lb/example-app-frontend build",
    "deploy-path": "apps/frontend/dist",
    "params": {
      "www-redirect": false
    },
    "local-config": "apps/frontend/vercel.json"
  },
  "docs": {
    "module": "vercel-static",
    "domain": "example-app-docs.mp-lb.dev",
    "build": "pnpm --filter @mp-lb/example-app-docs build",
    "deploy-path": "apps/docs/build/client",
    "params": {
      "www-redirect": false
    }
  }
}
