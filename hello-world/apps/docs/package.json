{
  "name": "@hello-world/hello-world-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --host 0.0.0.0 --port ${DOCS_PORT:-4315}",
    "start": "serve ./build/client --config serve.json -l ${DOCS_PORT:-4315}",
    "types:check": "react-router typegen && tsc --noEmit",
    "typecheck": "react-router typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "cn": "0.4.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "isbot": "5.2.2",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "takumi-js": "2.14.0"
  },
  "devDependencies": {
    "@mp-lb/fssstack-config": "0.3.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-router-devtools": "6.2.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
