{
  "name": "@example/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && electron-builder --mac --publish never",
    "package:local": "pnpm build && electron-builder --mac --dir --publish never -c.mac.identity=null -c.mac.notarize=false -c.mac.hardenedRuntime=false"
  },
  "devDependencies": {
    "@types/node": "^22",
    "electron": "35.0.0",
    "electron-builder": "26.8.1",
    "tsup": "8.5.0",
    "typescript": "^5.9"
  },
  "build": {
    "appId": "dev.example.desktop",
    "productName": "Example",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
